{
  "name": "osm-auth",
  "version": "3.2.0",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmlab/osm-auth.git"
  },
  "description": "A usable example of JavaScript OAuth 2.0 with OpenStreetMap",
  "keywords": [
    "oauth",
    "openstreetmap",
    "ohauth"
  ],
  "contributors": [
    "Bryan Housel  <bhousel@gmail.com> (https://github.com/bhousel)",
    "Daniel Schep (https://github.com/dschep)",
    "Hel Nershing Thapa (https://github.com/HelNershingThapa)",
    "Tom MacWright <tom@macwright.org> (https://github.com/tmcw)"
  ],
  "files": [
    "dist/",
    "src/"
  ],
  "type": "module",
  "exports": {
    "types": "./dist/ts/osm-auth.d.ts",
    "bun": "./src/osm-auth.ts",
    "import": "./dist/js/osm-auth.mjs",
    "require": "./dist/js/osm-auth.mjs",
    "browser": "./dist/js/osm-auth.iife.js",
    "default": "./dist/js/osm-auth.mjs"
  },
  "scripts": {
    "all": "bun run --sequential clean check build test package",
    "package": "bun run --sequential package:pack package:publint package:attw",
    "package:pack": "bun pm pack --quiet --ignore-scripts --destination ./build",
    "package:publint": "publint --level warning ./build/*.tgz",
    "package:attw": "attw --profile esm-only --no-summary ./build/*.tgz",
    "check": "bun run --parallel 'check:*'",
    "check:lint": "oxlint ./scripts ./src ./test",
    "check:types": "tsc --noEmit",
    "build": "bun run --parallel 'build:*'",
    "build:js": "bun ./scripts/build_js.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "clean": "bun ./scripts/clean.ts",
    "start": "bun ./scripts/server.ts",
    "test": "bun test --dots --coverage ./test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/bun": "^1.3.11",
    "node-localstorage": "^3.0.5",
    "oxlint": "^1.93.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.10"
  }
}
